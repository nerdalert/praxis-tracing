# syntax=docker/dockerfile:1

FROM node:22-alpine AS frontend

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY index.html vite.config.ts tsconfig.json ./
COPY src ./src
RUN npm run build && npm prune --omit=dev

FROM node:22-alpine AS runtime

WORKDIR /app

# The gated cloud-burst panel can use the pod's projected ServiceAccount token
# through kubectl. The RBAC manifest grants only namespaced read/patch access.
RUN apk add --no-cache kubectl

COPY --from=frontend /app/package.json /app/package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY server.js overlay.json ./
COPY --from=frontend /app/dist ./dist
COPY public ./public
COPY scripts ./scripts

ENV NODE_ENV=production
ENV PORT=8080

USER node
EXPOSE 8080

CMD ["node", "server.js"]
